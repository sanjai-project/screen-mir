name: Build Windows app
on:
  push:
  workflow_dispatch:
jobs:
  build:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - run: pip install pyinstaller pyautogui
      - run: pyinstaller --noconfirm --windowed --name LaptopMirror laptop_app.py
      - name: Bundle ffmpeg and adb
        shell: pwsh
        run: |
          New-Item -ItemType Directory dist/LaptopMirror/bin | Out-Null
          Invoke-WebRequest https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-win64-gpl.zip -OutFile ff.zip
          Expand-Archive ff.zip ff
          Copy-Item (Get-ChildItem ff -Recurse -Filter ffmpeg.exe | Select-Object -First 1).FullName dist/LaptopMirror/bin/
          Invoke-WebRequest https://dl.google.com/android/repository/platform-tools-latest-windows.zip -OutFile pt.zip
          Expand-Archive pt.zip pt
          foreach ($f in "adb.exe","AdbWinApi.dll","AdbWinUsbApi.dll") { Copy-Item "pt/platform-tools/$f" dist/LaptopMirror/bin/ }
      - uses: actions/upload-artifact@v4
        with:
          name: LaptopMirror-Windows
          path: dist/LaptopMirror
